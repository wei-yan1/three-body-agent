DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_DOCUMENT_EMBEDDING_MODEL=text-embedding-v2
DASHSCOPE_QUERY_EMBEDDING_MODEL=text-embedding-v2
DASHSCOPE_RERANK_MODEL=qwen3-rerank
# Embedding backend: dashscope or ollama. Ollama keeps document/query text local.
EMBEDDING_PROVIDER=dashscope
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optional version string. Change it when the local model weights change.
OLLAMA_EMBEDDING_MODEL_VERSION=
# Optional version string for remote embedding model revisions.
DASHSCOPE_EMBEDDING_MODEL_VERSION=
TAVILY_API_KEY=your_optional_tavily_api_key_for_transparent_mode
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=three_body_agent
# Optional: use a full connection string instead of POSTGRES_* variables.
# POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/three_body_agent
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CHAT_MEMORY_TTL_SECONDS=43200
CHAT_MEMORY_MAX_MESSAGES=20
EPISODIC_MEMORY_CAPACITY=40
EPISODIC_FORGET_THRESHOLD=0.4
EPISODIC_RECALL_BOOST=0.05
EPISODIC_MAX_IMPORTANCE=0.95
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10080
TEST_CHAT_MODEL=qwen3.7-plus
PROD_CHAT_MODEL=qwen3.7-max
ROUTER_MODEL=glm-5
# Router defaults to DASHSCOPE_API_KEY and DASHSCOPE_BASE_URL.
# ROUTER_API_KEY=optional_different_router_key
# ROUTER_BASE_URL=optional_different_router_base_url
DEFAULT_CHAT_MODEL=qwen3.7-plus
REWRITE_CHAT_MODEL=qwen3.7-plus

# Import-time indexing: parse -> chunk -> embedding -> Chroma + persistent BM25
STORYROLE_AUTO_INDEX=1
STORYROLE_CHROMA_DIR=data/indexes/chroma
STORYROLE_INDEX_COLLECTION_PREFIX=storyrole_novel_
STORYROLE_EMBED_BATCH_SIZE=40
STORYROLE_EMBED_WORKERS=5
STORYROLE_EMBED_MAX_RETRIES=5
STORYROLE_EMBED_RATE_PER_SECOND=0

# StoryRole A2A transport: local keeps agents in-process; http enables remote agents.
STORYROLE_A2A_TRANSPORT=local
STORYROLE_A2A_BASE_URL=http://127.0.0.1:1314
STORYROLE_A2A_TIMEOUT=60
# Optional shared secret for remote A2A service-to-service calls.
# STORYROLE_A2A_SHARED_SECRET=change-me
STORYROLE_NUWA_MODEL=qwen3.7-plus
STORYROLE_CHAT_MODEL=qwen3.7-plus
# Optional per-agent remote URLs:
# STORYROLE_A2A_URL_CHARACTER_RESOLVER=http://resolver:8000
# STORYROLE_A2A_URL_NUWA_PROFILER=http://nuwa:8000
# STORYROLE_A2A_URL_CHARACTER_CONVERSATION=http://conversation:8000

STORYROLE_REASONING_MODEL=qwen3.7-plus
STORYROLE_GUARD_MODEL=qwen3.7-plus
STORYROLE_GUARD_ENABLED=1

# laya (default, active with rule fallback), laya_shadow (compare only), or rule
STORYROLE_DECISION_BACKEND=laya
STORYROLE_LAYA_MODEL=convaiinnovations/laya-multilingual
STORYROLE_LAYA_DEVICE=auto

# Provider/model pricing per one million tokens. Values use the provider's billing currency.
# Keep this in sync with the provider pricing page; unknown remote prices are shown as "未配置".
# cached_input_per_million is optional and applies to cached prompt tokens.
MODEL_PRICING_JSON={"deepseek":{"deepseek-chat":{"input_per_million":2,"cached_input_per_million":0.2,"output_per_million":8},"deepseek-reasoner":{"input_per_million":4,"cached_input_per_million":1,"output_per_million":16},"deepseek-flash":{"input_per_million":2,"cached_input_per_million":0.2,"output_per_million":8}},"dashscope":{"qwen3.7-plus":{"input_per_million":2,"cached_input_per_million":0.5,"output_per_million":6},"qwen3-rerank":{"input_per_million":1,"output_per_million":0}}}
